{% load static %}
{% include 'animal_bite/header.html' %}
<div class="container-xl animal-bite-page my-5">
  <div class="card animal-bite-banner mb-4">
    <div class="card-body py-5 px-4">
      <div class="d-flex align-items-center justify-content-between gap-4 flex-column flex-md-row">
        <div>
          <h3 class="mb-2 fw-bold banner-title">
            <i class="fa-solid fa-file-chart-line me-2"></i>Claims Summary Report
          </h3>
          <div class="subtitle banner-subtitle">Animal Bite Management System - Claims Overview</div>
        </div>
        <div class="banner-icon shadow-sm">
          <i class="fa-solid fa-chart-bar fa-2x"></i>
        </div>
      </div>
    </div>
  </div>
  {% if has_submission %}
