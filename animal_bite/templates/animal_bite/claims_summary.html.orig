      <div id="claimsSummaryReport" style="display:none;">
        <table style="width:100%; border-collapse:collapse;">
          <tr>
            <td class="header title">Republic of the Philippines</td>
          </tr>
          <tr>
            <td class="header subtitle">PHILIPPINE HEALTH INSURANCE CORPORATION</td>
          </tr>
          <tr>
            <td class="header">City State Centre, 709 Shaw Boulevard, Pasig City</td>
          </tr>
          <tr>
            <td class="header">
              Call Center (02) 441-7442 &nbsp;&nbsp;&nbsp;
              Trunkline (02) 441-7444
            </td>
          </tr>
          <tr>
            <td class="header">email: actioncenter@philhealth.gov.ph</td>
          </tr>
          <tr>
            <td class="no-border">&nbsp;</td>
          </tr>
          <tr>
            <td class="header title">CLAIMS SUMMARY REPORT for ANIMAL BITES</td>
          </tr>
          <tr>
            <td class="no-border">&nbsp;</td>
          </tr>
          <tr>
            <td class="header left">
              <strong>Facility:</strong>
              BURAUEN MUNICIPAL HEALTH OFFICE ANIMAL BITE TREATMENT CENTER
              <span style="float:right;">
                <strong>Provider Code:</strong> ________________________
              </span>
            </td>
          </tr>
        </table>
        <br>
        <table class="report">
          <tr>
            <th rowspan="3" style="width:40px;"></th>
            <th rowspan="2" style="width:220px;">Patient Name</th>
            <th rowspan="3" colspan="2" style="width:70px;">Membership</th>
            <th rowspan="3" style="width:180px;">PhilHealth Identification Number (PIN) of Member</th>
            <th rowspan="3" style="width:120px;">Diagnosis (ICD Code)</th>
            <th colspan="4">Immunization Schedule (mm/dd/yyyy)</th>
            <th rowspan="3" style="width:180px;">
              Member's Signature
              <br>
              (for Authorized Signatory)
            </th>
          </tr>
          <tr>
            <th colspan="3">Anti-Rabies Vaccine</th>
            <th rowspan="2">RIG</th>
          </tr>
          <tr>
            <th>(Last Name, First Name, M.I.)</th>
            <th>Day 0</th>
